    {
      "label": "2. シリアル報告形式",
      "description": "報告方法を選択してください。バーコード、写真(OCR)で読めない場合は手入力してください",
      "type": "select",
      "bind": "txt100",
      "required": true,
      "options": [
        "",
        "バーコード",
        "写真",
        "手入力"
      ]
    },

    {
      "label": "シリアル番号",
      "description": "バーコードがある場合は読み取ってください",
      "type": "text",
      "bind": "txt101",
      "enableScan": true,
      "required": true,
      "showWhen": {
        "bind": "txt100",
        "value": "バーコード"
      }
    },

    {
