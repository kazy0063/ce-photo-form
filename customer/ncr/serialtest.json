{
  "logo": "/logos/voyix.png",
  "title": "シリアルテストフォームです",
  "description": "必要事項を記載してください。",
  "parameter1": "serialtest_ncr",
  "parameter2": "",
  "parameter3": "",
  "parameter4": "",
  "fields": [
    {
      "label": "1. SCを選択してください(テスト用　入力不要です)",
      "type": "scSelect",
      "bind": "txt1",
      "required": false
    },
    {
      "label": "2. 店舗名を選択してください(テスト用　入力不要です)",
      "type": "storeSelect",
      "bind": "txt99",
      "required": false
    },
    {
      "label": "3. 写真テスト①",
      "type": "file",
      "bind": "img1",
      "required": false
    },
    {
      "label": "4. 写真テスト②",
      "type": "file",
      "bind": "img2",
      "required": false
    },
    {
      "label": "5. 機種を選択してください",
      "type": "select",
      "bind": "txt3",
      "options": [
        "CX7",
        "CX7ⅱ",
        "Printer"
      ],
      "required": true,
      "allowOther": true
    },
    {
      "label": "6. シリアル報告形式",
      "type": "select",
      "bind": "txt100",
      "options": [
        "バーコード",
        "写真",
        "手入力"
      ],
      "required": true
    },
    {
      "label": "シリアル番号",
      "type": "text",
      "bind": "txt101",
      "enableScan": true,
      "showWhen": {
        "bind": "txt100",
        "value": "バーコード"
      }
    },
    {
      "label": "シリアル写真",
      "type": "file",
      "bind": "img101",
      "showWhen": {
        "bind": "txt100",
        "value": "写真"
      }
    },
    {
      "label": "シリアル番号",
      "type": "text",
      "bind": "txt102",
      "showWhen": {
        "bind": "txt100",
        "value": "手入力"
      }
    }
  ]
}
